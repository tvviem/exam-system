# Trỏ vào pod dev-exam (make -C infra dev-up). Sao chép thành .env để dùng.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgres://exam:exam@127.0.0.1:5434/exam
REDIS_URL=redis://127.0.0.1:6381/0
# Khóa mã hóa Phiếu tài khoản (AES-256-GCM, 32 byte base64). Tạo khóa riêng cho mỗi môi trường:
#   openssl rand -base64 32
# Mất khóa thì không mở lại được các phiếu còn hạn (phiếu chỉ sống 7 ngày).
SLIP_ENCRYPTION_KEY=REPLACE_ME_WITH_openssl_rand_base64_32
# Thư mục lưu file tải lên và Phiếu tài khoản (mặc định ./media-data, đã được .gitignore).
# MEDIA_DIR=./media-data

# Chỉ dùng cho `pnpm cli bootstrap-admin` (tạo Quản trị viên đầu tiên). Mật khẩu: ít nhất 10 ký tự.
# BOOTSTRAP_ADMIN_USERNAME=quantri
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_FULL_NAME=Quản trị hệ thống
# BOOTSTRAP_ADMIN_PASSWORD=

# Gửi thư (ADR-0009, docs/ops/gui-thu.md). KHÔNG đặt các biến SMTP_* ở dev: thư được in ra bảng điều khiển của worker để
# thử bằng tay. Chỉ production đặt, và phải đặt đủ bốn biến đầu (thiếu một biến thì api và worker không khởi động).
# Pod thử (drill, dr) tuyệt đối không có SMTP_HOST: exam-ctl.sh từ chối dựng pod.
# SMTP_HOST=smtp.gmail.com
# SMTP_USERNAME=tai-khoan-gui@gmail.com
# SMTP_PASSWORD=app-password-16-ky-tu
# EMAIL_FROM=tai-khoan-gui@gmail.com   # với Gmail phải trùng SMTP_USERNAME
# SMTP_PORT=587
# EMAIL_REPLY_TO=hotro@example.edu.vn
# EMAIL_FROM_NAME=BLUni Exam
# EMAIL_SUPPORT_CONTACT=Cần trợ giúp, hãy liên hệ Người ra đề hoặc quản trị viên của bạn.
# Hạn mức (mặc định như dưới): 400 thư mỗi 24 giờ, hàng loạt tối đa 300, cách nhau 6 giây, làm nóng 5 ngày đầu.
# EMAIL_LIMIT_TOTAL=400
# EMAIL_LIMIT_BULK=300
# EMAIL_MIN_GAP_SECONDS=6
# EMAIL_WARMUP_BULK=50,100,150,200,300
